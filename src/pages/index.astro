---
import BaseLayout from '../layouts/BaseLayout.astro';
import SeriesCard from '../components/SeriesCard.astro';
import PostList from '../components/PostList.astro';
import { SITE_AUTHOR, SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import FormattedDate from '../components/FormattedDate.astro';
import { Image } from 'astro:assets';
import { getSortedPosts, postDescription } from '../lib/posts';
import AvatarImage from '../assets/avatar.png';
import defaultHero from '../assets/hero-image-holder.jpg';
import { seriesData } from '../data/series';
import { useTranslations } from '../i18n/utils';
import { siteLocale } from '../i18n/ui';
const t = useTranslations();

const allPosts = await getSortedPosts();

const pinnedPost = allPosts.find(p => p.data.pinned) ?? null;
const pinnedDesc = pinnedPost ? postDescription(pinnedPost) : '';

const latestPosts = allPosts
  .filter(p => !p.data.pinned)
  .slice(0, 5);

const featuredSeries = Object.entries(seriesData).flatMap(([domainKey, domain]) =>
  Object.entries(domain.series)
    .filter(([, series]) => series.featured)
    .map(([seriesKey, series]) => ({
      domainKey,
      seriesKey,
      title: series.title,
      description: series.description,
      heroImage: series.heroImage,
      heroDarkness: series.heroDarkness,
      chapterCount: series.parts.reduce((sum, p) => sum + p.chapters.length, 0),
    }))
);

// ── JSON-LD 結構化資料 ──
const homeUrl = new URL('/', Astro.site).href;
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: SITE_TITLE,
    description: SITE_DESCRIPTION,
    url: homeUrl,
    inLanguage: siteLocale.html,
    author: { '@type': 'Person', name: SITE_AUTHOR },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Person',
    name: SITE_AUTHOR,
    url: homeUrl,
    image: new URL(AvatarImage.src, Astro.site).href,
  },
];
---

<BaseLayout title={SITE_TITLE} description={SITE_DESCRIPTION} jsonLd={jsonLd}>
			<div class="hero">
				<Image src={AvatarImage} alt={SITE_AUTHOR} width={400} height={400} class="avatar" />
				<h1>{SITE_AUTHOR}</h1>
				<p>{SITE_DESCRIPTION}</p>
			</div>

			{pinnedPost && (
				<section class="home-section">
					<h2 class="section-title">{t('home.pinned')}</h2>
					<a
						class="pinned-card"
						href={`/blog/${pinnedPost.id}/`}
					>
						<div class="pinned-banner">
							<Image
								src={pinnedPost.data.heroImage ?? defaultHero}
								alt=""
								width={1440}
								format="webp"
								quality={80}
								loading="eager"
								fetchpriority="high"
								class="pinned-banner-img"
							/>
						</div>
						<div class="pinned-plate">
							<div class="pinned-meta">
								<span class="pinned-badge">{t('home.pinnedBadge')}</span>
								<span class="pinned-date"><FormattedDate date={pinnedPost.data.pubDate} /></span>
								{pinnedPost.data.tags.slice(0, 3).map(tag => (
									<span class="pinned-tag">{tag}</span>
								))}
							</div>
							<h3 class="pinned-title">{pinnedPost.data.title}</h3>
							{pinnedDesc && <p class="pinned-desc">{pinnedDesc}</p>}
						</div>
					</a>
				</section>
			)}

			{featuredSeries.length > 0 && (
				<section class="home-section">
					<div class="section-header">
						<h2 class="section-title">{t('home.featuredSeries')}</h2>
						<a class="see-all" href="/series/">{t('home.seeAllSeries')}</a>
					</div>
					<div class="series-grid">
						{featuredSeries.map(s => (
							<SeriesCard
								href={`/series/${s.domainKey}/${s.seriesKey}/`}
								title={s.title}
								description={s.description}
								meta={[t('series.chapterCount', { n: s.chapterCount })]}
									headingLevel={3}
								heroImage={s.heroImage}
								heroDarkness={s.heroDarkness}
							/>
						))}
					</div>
				</section>
			)}

			<section class="home-section">
				<h2 class="section-title">{t('home.latestPosts')}</h2>
				<PostList posts={latestPosts} headingLevel={3} compact />
			</section>
</BaseLayout>

<style>
	.hero {
		text-align: center;
		padding: 2em 0;
	}
	.avatar {
		width: 200px;
		height: 200px;
		border-radius: 25%;
		margin-bottom: 1em;
	}

	/* ── 通用 section 間距 ── */
	.home-section {
		margin-bottom: 2.5rem;
	}

	.section-header {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		margin-bottom: 1rem;
	}

	.section-title {
		margin: 0 0 1rem 0;
		font-size: 1.5rem;
	}

	.section-header .section-title {
		margin-bottom: 0;
	}

	.see-all {
		font-size: 0.85rem;
		color: var(--accent-dark);
		text-decoration: none;
		white-space: nowrap;
	}
	.see-all:hover {
		text-decoration: underline;
	}

	/* ── 置頂文章橫幅（圖在上、文字在隨模式變色的底板）── */
	.pinned-card {
		display: flex;
		flex-direction: column;
		border-radius: 12px;
		overflow: hidden;
		text-decoration: none;
		color: inherit;
		background: rgba(var(--gray-light), 0.35);
		border: 1px solid rgba(var(--gray-light), 0.6);
		transition: transform 0.25s ease, box-shadow 0.25s ease;
	}
	.pinned-card:hover {
		transform: translateY(-3px);
		box-shadow: var(--box-shadow);
	}

	.pinned-banner {
		height: 240px;
		overflow: hidden;
	}
	.pinned-banner-img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center;
		display: block;
		transition: transform 0.35s ease;
	}
	.pinned-card:hover .pinned-banner-img {
		transform: scale(1.04);
	}

	/* 底板往上疊蓋橫幅約 34px：頂端半透明 + 模糊，透出 hero 圖；
	   在極短距離（~40px）淡出到純色 var(--bg)。文字靠 padding-top 推到純色段，
	   對比度完全不受 hero 圖明暗影響。*/
	.pinned-plate {
		position: relative;
		z-index: 1;
		margin-top: -34px;
		padding: 2.6rem 1.25rem 1.1rem;
		border-radius: 14px 14px 0 0;
		border-top: 1px solid var(--header-border);
		background: linear-gradient(to bottom, var(--pinned-plate-fade) 0, var(--bg) 40px);
		backdrop-filter: blur(12px) saturate(140%);
		-webkit-backdrop-filter: blur(12px) saturate(140%);
	}

	.pinned-meta {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		flex-wrap: wrap;
		margin-bottom: 0.5rem;
	}

	.pinned-badge {
		font-size: 0.68rem;
		font-weight: 700;
		padding: 0.15em 0.55em;
		border-radius: 4px;
		background: var(--pinned-badge-bg);
		color: var(--pinned-badge-fg);
		letter-spacing: 0.02em;
	}

	.pinned-date {
		font-size: 0.78rem;
		color: rgb(var(--gray));
	}

	.pinned-tag {
		font-size: 0.7rem;
		padding: 0.15em 0.55em;
		border-radius: 999px;
		background: rgba(var(--gray-light), 0.7);
		color: rgb(var(--gray-dark));
		border: 1px solid rgba(var(--gray), 0.25);
	}

	.pinned-title {
		margin: 0 0 0.3rem 0;
		font-size: 1.15rem;
		font-weight: 700;
		color: rgb(var(--black));
		line-height: 1.35;
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
		transition: color 0.2s ease;
	}
	.pinned-card:hover .pinned-title {
		color: var(--accent-dark);
	}

	.pinned-desc {
		margin: 0;
		font-size: 0.82rem;
		color: rgb(var(--gray));
		line-height: 1.5;
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}

	/* ── 精選系列 ── */
	.series-grid {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 1rem;
	}
	.series-grid > :global(:last-child:nth-child(odd)) {
		grid-column: 1 / -1;
	}

	/* ── 手機版 ── */
	@media (max-width: 720px) {
		.series-grid {
			grid-template-columns: 1fr;
		}

		.pinned-banner {
			height: 160px;
		}
	}
</style>
