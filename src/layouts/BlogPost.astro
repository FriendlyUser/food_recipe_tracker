---
import { Image } from 'astro:assets';
import { type CollectionEntry, getCollection } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import FormattedDate from '../components/FormattedDate.astro';
import type { MarkdownHeading } from 'astro';
import defaultHero from '../assets/hero-image-holder.jpg';
import { getChapterContext } from '../lib/series';
import { taxonomy } from '../data/taxonomy';
import { getAllLeafTags, toSlug } from '../lib/taxonomy';
import { SITE_AUTHOR } from '../consts';
import { toShareImage } from '../lib/og-image';
import Comments from '../components/Comments.astro';
import { useTranslations } from '../i18n/utils';
import { siteLocale } from '../i18n/ui';
const t = useTranslations();

type Props = Omit<CollectionEntry<'blog'>['data'], 'description'> & {
  description: string;
  id: string;
  headings: MarkdownHeading[];
  relatedPosts?: CollectionEntry<'blog'>[];
  readingTime: number;
};

const { title, description, pubDate, updatedDate, heroImage, headings, tags, relatedPosts = [], id, readingTime } = Astro.props;

const chapterCtx = getChapterContext(id);

let slugTitleMap: Map<string, string> | null = null;
if (chapterCtx) {
  const allPosts = await getCollection('blog');
  slugTitleMap = new Map(allPosts.map(p => [p.id, p.data.title]));
}

function resolveChapterTitle(chapter: { slug: string; title?: string } | null): string | null {
  if (!chapter) return null;
  return chapter.title ?? slugTitleMap?.get(chapter.slug) ?? chapter.slug;
}

const prevTitle = resolveChapterTitle(chapterCtx?.prev ?? null);
const nextTitle = resolveChapterTitle(chapterCtx?.next ?? null);

const resolvedParts = chapterCtx ? chapterCtx.series.parts.map(part => ({
  title: part.title,
  chapters: part.chapters.map(ch => ({
    slug: ch.slug,
    title: resolveChapterTitle(ch) ?? ch.slug,
  })),
})) : [];
const tocHeadings = headings.filter(h => h.depth <= 3);

// 計算頂層分類（Pagefind category 過濾維度）；掛群組名的隱含 tag 也算
const topCategories: string[] = [];
for (const [groupName, groupNode] of Object.entries(taxonomy)) {
  const leafTags = getAllLeafTags(groupNode);
  if ((tags ?? []).some(t => t === groupName || leafTags.includes(t))) {
    topCategories.push(groupName);
  }
}

// ── JSON-LD 結構化資料 ──
const postUrl = new URL(Astro.url.pathname, Astro.site).href;
const homeUrl = new URL('/', Astro.site).href;
// 與 BaseHead 的 og:image 同源（縮壓後的分享圖），不用原圖 .src
const imageUrl = new URL(await toShareImage(heroImage ?? defaultHero), Astro.site).href;
const author = { '@type': 'Person', name: SITE_AUTHOR, url: homeUrl };

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BlogPosting',
    headline: title,
    description,
    datePublished: pubDate.toISOString(),
    dateModified: (updatedDate ?? pubDate).toISOString(),
    image: imageUrl,
    inLanguage: siteLocale.html,
    url: postUrl,
    mainEntityOfPage: { '@type': 'WebPage', '@id': postUrl },
    author,
    publisher: author,
    ...(tags && tags.length > 0 ? { keywords: tags.join(', ') } : {}),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: t('breadcrumb.home'), item: homeUrl },
      { '@type': 'ListItem', position: 2, name: t('breadcrumb.blog'), item: new URL('/blog/', Astro.site).href },
      { '@type': 'ListItem', position: 3, name: title, item: postUrl },
    ],
  },
];
---

<style>
			/* main 全寬交給 BaseLayout 的 wide prop */
			.prose {
				width: 720px;
				max-width: calc(100% - 2em);
				margin: auto;
				padding: 1em;
				color: rgb(var(--gray-dark));
				grid-column: 2;
				min-width: 0; /* 防止 grid item 因寬 content 撐大 track */
			}
			.title {
				margin-bottom: 1em;
				padding: 1em 0;
				text-align: center;
				line-height: 1;
			}
			.title h1 {
				margin: 0 0 0.5em 0;
			}
			.date {
				margin-bottom: 0.5em;
				color: rgb(var(--gray));
			}
			.last-updated-on {
				font-style: italic;
			}
			.reading-time {
				margin-left: 0.4em;
			}

			/* ── 雙欄布局 ── */
			.post-layout {
				display: grid;
				grid-template-columns: 1fr minmax(0, 720px) 1fr;
				gap: 2rem;
				width: 100%;
			}

			/* ── 桌面版 TOC sidebar ── */
			.toc-sidebar {
				position: sticky;
				top: 5rem;
				max-height: calc(100vh - 6rem);
				overflow-y: auto;
				padding: 1rem 0;
				font-size: 1rem;
				grid-column: 1;
				justify-self: end;
				max-width: 220px;
				width: 100%;
			}
			.toc-sidebar h2 {
				font-size: 0.75rem;
				font-weight: 700;
				text-transform: uppercase;
				letter-spacing: 0.08em;
				color: rgb(var(--gray));
				margin: 0 0 0.75rem 0;
			}
			.toc-sidebar nav {
				display: flex;
				flex-direction: column;
				gap: 0.3rem;
			}
			.toc-link {
				display: block;
				color: rgb(var(--gray));
				text-decoration: none;
				line-height: 1.4;
				padding: 0.15rem 0.6rem;
				border-left: 2px solid transparent;
				transition: color 0.2s, border-color 0.2s;
				font-size: 0.85rem;
			}
			.toc-link:hover {
				color: var(--accent);
				border-left-color: var(--accent);
			}
			.toc-link.active {
				color: var(--accent);
				border-left-color: var(--accent);
				font-weight: 500;
			}
			.toc-link.depth-3 {
				padding-left: 1.4rem;
				font-size: 0.78rem;
			}

			/* 桌面：details 當透明容器 */
			@media (min-width: 901px) {
				.toc-sidebar details {
					display: contents;
				}
				.toc-sidebar summary {
					display: none;
				}
			}

			/* ── 桌面版 Series sidebar ── */
			.series-sidebar {
				position: sticky;
				top: 5rem;
				max-height: calc(100vh - 6rem);
				overflow-y: auto;
				padding: 1rem 0;
				grid-column: 3;
				grid-row: 1;
				justify-self: start;
				max-width: 220px;
				width: 100%;
			}
			.series-sidebar-heading {
				font-size: 0.75rem;
				font-weight: 700;
				text-transform: uppercase;
				letter-spacing: 0.08em;
				color: rgb(var(--gray));
				margin: 0 0 0.75rem 0;
				padding: 0 0.6rem;
			}
			.series-part {
				margin-bottom: 0.75rem;
			}
			.series-part-title {
				font-size: 0.68rem;
				font-weight: 700;
				text-transform: uppercase;
				letter-spacing: 0.06em;
				color: rgb(var(--gray));
				opacity: 0.6;
				margin: 0 0 0.25rem 0;
				padding: 0 0.6rem;
			}
			.series-chapter-link {
				display: block;
				color: rgb(var(--gray));
				text-decoration: none;
				line-height: 1.4;
				padding: 0.15rem 0.6rem;
				border-left: 2px solid transparent;
				transition: color 0.2s, border-color 0.2s;
				font-size: 0.83rem;
			}
			.series-chapter-link:hover {
				color: var(--accent);
				border-left-color: var(--accent);
			}
			.series-chapter-link.active {
				color: var(--accent);
				border-left-color: var(--accent);
				font-weight: 500;
			}

			/* ── Tags ── */
			.tag-list {
				display: flex;
				flex-wrap: wrap;
				gap: 0.4rem;
				justify-content: center;
				margin: 0.75rem 0 0;
			}
			.tag-chip {
				display: inline-block;
				padding: 0.2rem 0.7rem;
				border-radius: 999px;
				background-color: var(--accent-light);
				color: var(--accent-dark);
				font-size: 0.78rem;
				font-weight: 600;
				text-decoration: none;
				border: 1.5px solid transparent;
				transition: border-color 0.15s, background 0.15s, color 0.15s;
			}
			.tag-chip:hover {
				border-color: var(--accent);
				background: transparent;
				color: var(--accent);
			}

			/* ── 相似文章 ── */
			.related-posts {
				margin-top: 3rem;
				padding-top: 1.5rem;
				border-top: 1px solid rgb(var(--gray-light));
			}
			.related-title {
				font-size: 1rem;
				font-weight: 700;
				text-transform: uppercase;
				letter-spacing: 0.08em;
				color: rgb(var(--gray));
				margin: 0 0 1rem 0;
			}
			.related-list {
				list-style: none;
				margin: 0;
				padding: 0;
				display: grid;
				grid-template-columns: repeat(3, 1fr);
				gap: 0.75rem;
			}
			.related-card {
				display: flex;
				flex-direction: column;
				text-decoration: none;
				color: inherit;
				border-radius: 10px;
				overflow: hidden;
				background: rgba(var(--gray-light), 0.3);
				border: 1px solid rgba(var(--gray-light), 0.5);
				transition: transform 0.2s ease, box-shadow 0.2s ease;
			}
			.related-card:hover {
				transform: translateY(-2px);
				box-shadow: var(--box-shadow);
			}
			.related-img {
				width: 100%;
				height: 100px;
				object-fit: cover;
				display: block;
				transition: transform 0.3s ease;
			}
			.related-card:hover .related-img {
				transform: scale(1.05);
			}
			.related-body {
				padding: 0.6rem 0.75rem 0.75rem;
				display: flex;
				flex-direction: column;
				gap: 0.25rem;
				flex: 1;
			}
			.related-date {
				margin: 0;
				font-size: 0.72rem;
				color: rgb(var(--gray));
			}
			.related-post-title {
				margin: 0;
				font-size: 0.85rem;
				font-weight: 600;
				line-height: 1.35;
				color: rgb(var(--black));
				display: -webkit-box;
				-webkit-line-clamp: 2;
				-webkit-box-orient: vertical;
				overflow: hidden;
				transition: color 0.15s;
			}
			.related-card:hover .related-post-title {
				color: var(--accent-dark);
			}
			.related-tags {
				display: flex;
				flex-wrap: wrap;
				gap: 0.25rem;
				margin-top: 0.25rem;
			}
			.related-tag {
				font-size: 0.68rem;
				padding: 0.1em 0.45em;
				border-radius: 999px;
				background: rgba(var(--gray-light), 0.7);
				color: rgb(var(--gray-dark));
				border: 1px solid rgba(var(--gray), 0.2);
			}
			@media (max-width: 600px) {
				.related-list {
					grid-template-columns: 1fr;
				}
				.related-card {
					flex-direction: row;
				}
				.related-img {
					width: 100px;
					height: auto;
					aspect-ratio: 4 / 3;
					flex-shrink: 0;
					object-fit: cover;
				}
			}

			/* ── 手機版 ── */
			@media (max-width: 900px) {
				.post-layout {
					grid-template-columns: 1fr;
					padding: 0;
					gap: 0;
				}

				/* 修正：手機只有一欄，prose 必須在 column 1 */
				.prose {
					grid-column: 1;
					width: 100%;
					max-width: 100%;
					box-sizing: border-box;
				}

				/* 側欄在手機隱藏 */
				.toc-sidebar,
				.series-sidebar {
					display: none;
				}
			}

			/* ── FAB（手機專用）── */
			.toc-fab {
				display: none;
			}

			@media (max-width: 900px) {
				.toc-fab {
					display: flex;
					align-items: center;
					justify-content: center;
					position: fixed;
					bottom: 1.5rem;
					right: 1.5rem;
					width: 48px;
					height: 48px;
					border-radius: 50%;
					background: var(--accent-fill);
					color: var(--on-accent-fill);
					border: none;
					cursor: pointer;
					box-shadow: 0 4px 14px rgba(0, 0, 0, 0.25);
					z-index: 100;
					transition: transform 0.2s ease, box-shadow 0.2s ease;
				}
				.toc-fab:hover {
					transform: scale(1.08);
					box-shadow: 0 6px 18px rgba(0, 0, 0, 0.3);
				}
				.toc-fab:active {
					transform: scale(0.95);
				}
			}

			/* ── Backdrop ── */
			.toc-backdrop {
				display: none;
				position: fixed;
				inset: 0;
				background: rgba(0, 0, 0, 0.45);
				z-index: 200;
				opacity: 0;
				transition: opacity 0.3s ease;
			}
			.toc-backdrop.open {
				opacity: 1;
			}
			@media (max-width: 900px) {
				.toc-backdrop {
					display: block;
					pointer-events: none;
				}
				.toc-backdrop.open {
					pointer-events: auto;
				}
			}

			/* ── Bottom Sheet ── */
			.toc-sheet {
				display: none;
				position: fixed;
				bottom: 0;
				left: 0;
				right: 0;
				background: var(--bg);
				border-radius: 16px 16px 0 0;
				border-top: 1px solid rgba(var(--gray-light), 0.6);
				z-index: 300;
				max-height: 65vh;
				overflow-y: auto;
				transform: translateY(100%);
				transition: transform 0.35s cubic-bezier(0.32, 0.72, 0, 1);
				padding: 0 1.25rem 2rem;
			}
			.toc-sheet.open {
				transform: translateY(0);
			}
			/* 容器承接程式化焦點（tabindex="-1"，modal-a11y 約定），不畫 focus ring */
			.toc-sheet:focus {
				outline: none;
			}
			@media (max-width: 900px) {
				.toc-sheet {
					display: block;
				}
			}

			.toc-sheet-handle {
				width: 36px;
				height: 4px;
				border-radius: 2px;
				background: rgba(var(--gray), 0.4);
				margin: 0.75rem auto 0;
			}
			.toc-sheet-header {
				display: flex;
				align-items: center;
				justify-content: space-between;
				padding: 0.75rem 0 0.5rem;
				border-bottom: 1px solid rgba(var(--gray-light), 0.5);
				margin-bottom: 0.75rem;
			}
			.toc-sheet-header span {
				font-size: 0.78rem;
				font-weight: 700;
				text-transform: uppercase;
				letter-spacing: 0.08em;
				color: rgb(var(--gray));
			}
			.toc-sheet-close {
				background: none;
				border: none;
				cursor: pointer;
				color: rgb(var(--gray));
				padding: 0.2rem 0.4rem;
				font-size: 1rem;
				line-height: 1;
				border-radius: 4px;
				transition: color 0.15s;
			}
			.toc-sheet-close:hover {
				color: rgb(var(--black));
			}
			.toc-sheet-nav {
				display: flex;
				flex-direction: column;
				gap: 0.1rem;
			}
			.toc-sheet-link {
				display: block;
				padding: 0.55rem 0.5rem;
				color: rgb(var(--gray-dark));
				text-decoration: none;
				font-size: 0.9rem;
				line-height: 1.4;
				border-radius: 6px;
				transition: background 0.15s, color 0.15s;
			}
			.toc-sheet-link:hover,
			.toc-sheet-link:active {
				background: rgba(var(--gray-light), 0.5);
				color: var(--accent);
			}
			.toc-sheet-link.depth-3 {
				padding-left: 1.4rem;
				font-size: 0.82rem;
				color: rgb(var(--gray));
			}

			/* ── 系列文章導覽 ── */
			.chapter-nav-section {
				margin-top: 2.5rem;
				padding-top: 1.5rem;
				border-top: 1px solid rgb(var(--gray-light));
			}
			.chapter-series-label {
				font-size: 0.8rem;
				color: rgb(var(--gray));
				margin: 0 0 1rem 0;
			}
			.chapter-series-label a {
				color: var(--accent);
				text-decoration: none;
			}
			.chapter-series-label a:hover {
				text-decoration: underline;
			}
			.chapter-nav {
				display: grid;
				grid-template-columns: 1fr 1fr;
				gap: 0.75rem;
			}
			.chapter-nav-item {
				display: flex;
				flex-direction: column;
				text-decoration: none;
				padding: 0.875rem 1rem;
				border: 1px solid rgba(var(--gray-light), 0.7);
				border-radius: 10px;
				background: rgba(var(--gray-light), 0.15);
				transition: border-color 0.2s, background 0.2s;
				gap: 0.2rem;
				min-width: 0;
			}
			.chapter-nav-item:hover {
				border-color: var(--accent);
				background: rgba(var(--gray-light), 0.3);
			}
			.chapter-nav-item.next {
				text-align: right;
			}
			.nav-direction {
				font-size: 0.72rem;
				font-weight: 700;
				text-transform: uppercase;
				letter-spacing: 0.06em;
				color: var(--accent);
			}
			.nav-part {
				font-size: 0.72rem;
				color: rgb(var(--gray));
			}
			.nav-title {
				font-size: 0.88rem;
				font-weight: 600;
				color: rgb(var(--black));
				line-height: 1.4;
				display: -webkit-box;
				-webkit-line-clamp: 2;
				-webkit-box-orient: vertical;
				overflow: hidden;
				transition: color 0.15s;
			}
			.chapter-nav-item:hover .nav-title {
				color: var(--accent-dark);
			}
			@media (max-width: 600px) {
				.chapter-nav {
					grid-template-columns: 1fr;
				}
			}

			/* ── Code Block Copy Button（:global 因為是 JS 動態建立的元素）── */
			:global(.code-wrapper) {
				position: relative;
			}
			:global(.copy-btn) {
				position: absolute;
				top: 0.5rem;
				right: 0.5rem;
				display: flex;
				align-items: center;
				justify-content: center;
				width: 2rem;
				height: 2rem;
				border-radius: 6px;
				border: 1px solid rgba(var(--gray), 0.3);
				background: rgba(var(--gray-light), 0.15);
				color: rgb(var(--gray));
				cursor: pointer;
				opacity: 0;
				transition: opacity 0.15s, background 0.15s, color 0.15s;
				z-index: 1;
			}
			:global(.code-wrapper:hover .copy-btn) {
				opacity: 1;
			}
			:global(.copy-btn:hover) {
				background: rgba(var(--gray-light), 0.5);
				color: rgb(var(--black));
			}
			:global(.copy-btn.copied) {
				opacity: 1;
				color: #22c55e;
				border-color: #22c55e;
			}
			/* 手機永遠顯示 */
			@media (max-width: 900px) {
				:global(.copy-btn) {
					opacity: 1;
				}
			}

			/* ── Callout / Admonition（markdown `> [!NOTE]`）──
			   :global 因為 markdown 產生的 HTML 不帶 Astro scope attribute。
			   每型用 --mk-c（邊框/圖示）+ --mk-fg（標題，已量化 WCAG，token 在 global.css）。
			   底色用 color-mix 把邊框色以 --callout-tint 比例混進頁面底，明暗自動切換。*/
			:global(.markdown-alert) {
				margin: 1.25rem 0;
				padding: 0.7rem 1rem;
				border-left: 0.25rem solid var(--mk-c);
				border-radius: 6px;
				background: color-mix(in srgb, var(--mk-c) var(--callout-tint), transparent);
				color: rgb(var(--gray-dark));
			}
			:global(.markdown-alert > :first-child) { margin-top: 0; }
			:global(.markdown-alert > :last-child) { margin-bottom: 0; }

			:global(.markdown-alert-note)      { --mk-c: var(--callout-note-c);      --mk-fg: var(--callout-note-fg); }
			:global(.markdown-alert-tip)       { --mk-c: var(--callout-tip-c);       --mk-fg: var(--callout-tip-fg); }
			:global(.markdown-alert-important) { --mk-c: var(--callout-important-c); --mk-fg: var(--callout-important-fg); }
			:global(.markdown-alert-warning)   { --mk-c: var(--callout-warning-c);   --mk-fg: var(--callout-warning-fg); }
			:global(.markdown-alert-caution)   { --mk-c: var(--callout-caution-c);   --mk-fg: var(--callout-caution-fg); }

			/* 標頭：圖示 + 中文（::before）+ 英文（外掛原生）。flex order 讓圖示排最前。
			   中文較大為主、英文較小當後綴；兩者同色（--mk-fg 已驗證對比）。*/
			:global(.markdown-alert-title) {
				display: flex;
				align-items: center;
				gap: 0.4em;
				margin: 0 0 0.5rem 0;
				font-size: 0.8rem;
				font-weight: 700;
				letter-spacing: 0.03em;
				color: var(--mk-fg);
				line-height: 1.2;
			}
			:global(.markdown-alert-title svg.octicon) {
				order: -1;
				fill: var(--mk-c);
				flex-shrink: 0;
			}
			:global(.markdown-alert-title::before) { font-size: 1.15em; letter-spacing: normal; }
			:global(.markdown-alert-note .markdown-alert-title::before)      { content: '注意'; }
			:global(.markdown-alert-tip .markdown-alert-title::before)       { content: '提示'; }
			:global(.markdown-alert-important .markdown-alert-title::before) { content: '重要'; }
			:global(.markdown-alert-warning .markdown-alert-title::before)   { content: '警告'; }
			:global(.markdown-alert-caution .markdown-alert-title::before)   { content: '危險'; }

			/* ── 標題錨點（rehype-autolink-headings，append 一個 # 連結）──
			   hover 標題才浮現；觸控裝置沒有 hover 故常駐淡顯（同 BlogrollCard 外連箭頭）。*/
			:global(.prose :is(h1, h2, h3, h4, h5, h6) > .heading-anchor) {
				margin-left: 0.35em;
				color: var(--accent);
				text-decoration: none;
				font-weight: 400;
				opacity: 0;
				transition: opacity 0.15s ease;
			}
			:global(.prose :is(h1, h2, h3, h4, h5, h6):hover > .heading-anchor),
			:global(.prose .heading-anchor:focus-visible) {
				opacity: 1;
			}
			@media (hover: none) {
				:global(.prose :is(h1, h2, h3, h4, h5, h6) > .heading-anchor) {
					opacity: 0.45;
				}
			}

			/* ── 註腳（GFM footnotes，自動生成於文末）──
			   :global 因為 <section class="footnotes"> 是 markdown 管線產生、不帶 Astro scope。
			   分隔線沿用系列導覽／相似文章的慣例（border-top + gray-light）；內文略小且降一階。*/
			:global(.prose .footnotes) {
				margin-top: 2.5rem;
				padding-top: 1.5rem;
				border-top: 1px solid rgb(var(--gray-light));
				font-size: 0.9rem;
				color: rgb(var(--gray));
			}

			/* ── Image Lightbox ── */
			/* :global 因為 markdown 圖片不帶 Astro scope attribute */
			:global(.prose img) {
				cursor: zoom-in;
				border-radius: 6px;
			}
			/* lightbox 本體在 template 裡，用一般 scoped 即可 */
			.img-lightbox {
				position: fixed;
				inset: 0;
				background: rgba(0, 0, 0, 0);
				z-index: 1000;
				display: flex;
				align-items: center;
				justify-content: center;
				cursor: zoom-out;
				pointer-events: none;
				transition: background 0.25s ease;
			}
			.img-lightbox.open {
				background: rgba(0, 0, 0, 0.85);
				pointer-events: auto;
			}
			/* 容器承接程式化焦點（tabindex="-1"，modal-a11y 約定），不畫 focus ring */
			.img-lightbox:focus {
				outline: none;
			}
			.img-lightbox img {
				max-width: 90vw;
				max-height: 90vh;
				object-fit: contain;
				border-radius: 6px;
				cursor: default;
				box-shadow: 0 8px 40px rgba(0, 0, 0, 0.6);
				transform: scale(0.88);
				opacity: 0;
				transition: transform 0.3s cubic-bezier(0.34, 1.4, 0.64, 1), opacity 0.25s ease;
			}
			.img-lightbox.open img {
				transform: scale(1);
				opacity: 1;
			}
</style>

<BaseLayout title={title} description={description} image={heroImage} jsonLd={jsonLd} ogType="article" wide>
	<article>
				<div class={"post-layout" + (tocHeadings.length === 0 ? ' no-toc' : '')}>

					<!-- 桌面版 TOC sidebar -->
					{tocHeadings.length > 0 && (
						<aside class="toc-sidebar">
							<details open>
								<summary>{t('post.toc')}</summary>
								<nav id="toc-desktop">
									{tocHeadings.map(h => (
										<a href={'#' + h.slug} class={'toc-link depth-' + h.depth}>
											{h.text}
										</a>
									))}
								</nav>
							</details>
						</aside>
					)}

					<!-- 文章本體 -->
					<div class="prose" data-pagefind-body>
						<div class="title">
							<h1>{title}</h1>
							<div class="date">
								<FormattedDate date={pubDate} />
								<span class="reading-time">· {t('post.readingTime', { n: readingTime })}</span>
								{updatedDate && (
									<div class="last-updated-on">
										{t('post.lastUpdated')} <FormattedDate date={updatedDate} />
									</div>
								)}
							</div>
							{tags && tags.length > 0 && (
								<div class="tag-list">
									{tags.map(tag => (
										<a class="tag-chip" data-pagefind-filter="tag" href={`/tags/${toSlug(tag)}/`}>
											{tag}
										</a>
									))}
								</div>
							)}
							<hr />
						</div>
						{/* Pagefind 過濾維度（視覺隱藏，供 category / series 篩選器使用） */}
						{topCategories.map(cat => (
							<span data-pagefind-filter="category" aria-hidden="true" style="display:none">{cat}</span>
						))}
						{chapterCtx && (
							<span data-pagefind-filter="series" aria-hidden="true" style="display:none">{chapterCtx.series.title}</span>
						)}
						<slot />

						<!-- 系列文章導覽 -->
						{chapterCtx && (
							<div class="chapter-nav-section" data-pagefind-ignore>
								<p class="chapter-series-label">
									{t('post.belongsTo')}
									<a href={`/series/${chapterCtx.domainKey}/`}>{chapterCtx.domainTitle}</a>
									{' › '}
									<a href={`/series/${chapterCtx.domainKey}/${chapterCtx.seriesKey}/`}>{chapterCtx.series.title}</a>
									{' › '}
									{chapterCtx.part.title}
								</p>
								{(chapterCtx.prev || chapterCtx.next) && (
									<nav class="chapter-nav" aria-label={t('post.seriesNav')}>
										{chapterCtx.prev ? (
											<a class="chapter-nav-item" href={`/blog/${chapterCtx.prev.slug}/`}>
												<span class="nav-direction">{t('post.prev')}</span>
												<span class="nav-part">{chapterCtx.prev.partTitle}</span>
												<span class="nav-title">{prevTitle}</span>
											</a>
										) : <span />}
										{chapterCtx.next ? (
											<a class="chapter-nav-item next" href={`/blog/${chapterCtx.next.slug}/`}>
												<span class="nav-direction">{t('post.next')}</span>
												<span class="nav-part">{chapterCtx.next.partTitle}</span>
												<span class="nav-title">{nextTitle}</span>
											</a>
										) : <span />}
									</nav>
								)}
							</div>
						)}

						<!-- 留言板（系列導覽後、相似文章前；provider='none' 時不渲染）-->
						<Comments />

						<!-- 相似文章 -->
						{relatedPosts.length > 0 && (
							<aside class="related-posts" data-pagefind-ignore>
								<h2 class="related-title">{t('post.related')}</h2>
								<ul class="related-list">
									{relatedPosts.map(p => (
										<li>
											<a href={`/blog/${p.id}/`} class="related-card">
												<Image
													class="related-img"
													src={p.data.heroImage ?? defaultHero}
													alt=""
													width={240}
													height={135}
												/>
												<div class="related-body">
													<p class="related-date">
														<FormattedDate date={p.data.pubDate} />
													</p>
													<p class="related-post-title">{p.data.title}</p>
													{p.data.tags.length > 0 && (
														<div class="related-tags">
															{p.data.tags.slice(0, 2).map(tag => (
																<span class="related-tag">{tag}</span>
															))}
														</div>
													)}
												</div>
											</a>
										</li>
									))}
								</ul>
							</aside>
						)}
					</div>

					<!-- 桌面版 Series sidebar -->
					{chapterCtx && (
						<aside class="series-sidebar" aria-label={t('post.seriesNav')}>
							<p class="series-sidebar-heading">{chapterCtx.series.title}</p>
							{resolvedParts.map(part => (
								<div class="series-part">
									<p class="series-part-title">{part.title}</p>
									{part.chapters.map(ch => (
										<a
											href={`/blog/${ch.slug}/`}
											class={'series-chapter-link' + (ch.slug === id ? ' active' : '')}
										>
											{ch.title}
										</a>
									))}
								</div>
							))}
						</aside>
					)}
				</div>
	</article>

	<Fragment slot="after-footer">
		<!-- 手機版 TOC FAB + Bottom Sheet -->
		{tocHeadings.length > 0 && (
			<>
				<button class="toc-fab" id="toc-fab" aria-label={t('post.openToc')}>
					<svg width="20" height="20" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
						<rect x="2" y="3" width="16" height="2" rx="1"/>
						<rect x="2" y="9" width="12" height="2" rx="1"/>
						<rect x="2" y="15" width="14" height="2" rx="1"/>
					</svg>
				</button>

				<div class="toc-backdrop" id="toc-backdrop"></div>

				<div class="toc-sheet" id="toc-sheet" role="dialog" aria-modal="true" aria-label={t('post.toc')} tabindex="-1">
					<div class="toc-sheet-handle"></div>
					<div class="toc-sheet-header">
						<span>{t('post.toc')}</span>
						<button class="toc-sheet-close" id="toc-sheet-close" aria-label={t('post.closeToc')}>✕</button>
					</div>
					<nav class="toc-sheet-nav">
						{tocHeadings.map(h => (
							<a href={'#' + h.slug} class={'toc-sheet-link depth-' + h.depth}>
								{h.text}
							</a>
						))}
					</nav>
				</div>
			</>
		)}

		<!-- Image Lightbox -->
		<div class="img-lightbox" id="img-lightbox" role="dialog" aria-modal="true" aria-label={t('post.imageZoom')} tabindex="-1">
			<img id="lightbox-img" src="" alt="" />
		</div>
	</Fragment>
</BaseLayout>

<script>
			import { useTranslations } from '../i18n/utils';
			import { trapModal, releaseModal } from '../lib/modal-a11y';
			const t = useTranslations();

			/* 重要：ClientRouter（View Transitions）換頁時不會重新執行此 module script，
			   只會抽換 DOM。所以每頁的 DOM 相關初始化都掛在 astro:page-load
			   （首次載入與每次換頁皆觸發），否則換頁後複製按鈕、TOC highlight 會失效。
			   document 級別的監聽（Escape）只在 module 載入時掛一次，避免換頁累積洩漏。 */

			/* ── 桌面版 TOC：依捲動位置高亮目前章節 ──
			   不用 IntersectionObserver 的薄偵測區：頁面底部的章節捲不進那條帶子裡
			   （下方內容不夠長），跳轉過去時高亮會卡在前一節。改用捲動位置判斷——
			   取「最後一個越過啟用線的標題」，再加頁面底部的補救（強制高亮最後一節）。 */
			let tocScrollHandler: (() => void) | null = null;
			function setupTocObserver() {
				if (tocScrollHandler) {
					window.removeEventListener('scroll', tocScrollHandler);
					window.removeEventListener('resize', tocScrollHandler);
					tocScrollHandler = null;
				}
				const tocLinks = document.querySelectorAll<HTMLAnchorElement>('.toc-link');
				// 只追蹤「TOC 裡有對應連結」的標題：排除文章標題 h1（無 id），也排除
				// GFM 自動產生的註腳區塊標題（id="footnote-label"，不在 TOC，否則底部補救
				// 會選到它而清掉高亮）。
				const linkedIds = new Set(
					Array.from(tocLinks, l => l.getAttribute('href')).filter((h): h is string => !!h)
				);
				const headingEls = Array.from(
					document.querySelectorAll<HTMLHeadingElement>('.prose h1, .prose h2, .prose h3')
				).filter(el => el.id && linkedIds.has(`#${el.id}`));

				if (tocLinks.length === 0 || headingEls.length === 0) return;

				const setActive = () => {
					// 啟用線：與 scroll-padding-top（sticky header 落點）對齊，略低一點點，
					// 讓跳轉後落在 header 下緣的標題立即被視為「目前章節」。
					const pad = parseFloat(getComputedStyle(document.documentElement).scrollPaddingTop) || 80;
					const line = pad + 4;
					// 文件順序由上而下：最後一個 top 已越過啟用線的標題即為目前章節。
					let activeId = headingEls[0].id;
					for (const el of headingEls) {
						if (el.getBoundingClientRect().top <= line) activeId = el.id;
						else break;
					}
					// 捲到頁面底部時，剩餘章節擠在啟用線之下永遠選不到 → 強制高亮最後一節。
					const atBottom =
						Math.ceil(window.scrollY + window.innerHeight) >= document.documentElement.scrollHeight - 2;
					if (atBottom) activeId = headingEls[headingEls.length - 1].id;

					tocLinks.forEach(l => l.classList.toggle('active', l.getAttribute('href') === `#${activeId}`));
				};

				let ticking = false;
				tocScrollHandler = () => {
					if (ticking) return;
					ticking = true;
					requestAnimationFrame(() => {
						setActive();
						ticking = false;
					});
				};
				window.addEventListener('scroll', tocScrollHandler, { passive: true });
				window.addEventListener('resize', tocScrollHandler, { passive: true });
				setActive(); // 初始狀態（含帶 hash 直接載入時的落點）
			}

			/* ── 手機版 TOC：FAB + Bottom Sheet ── */
			function setupMobileToc() {
				const fab = document.getElementById('toc-fab');
				const sheet = document.getElementById('toc-sheet');
				const backdrop = document.getElementById('toc-backdrop');
				const closeBtn = document.getElementById('toc-sheet-close');

				const openSheet = () => {
					if (!sheet || sheet.classList.contains('open')) return;
					sheet.classList.add('open');
					backdrop?.classList.add('open');
					document.body.style.overflow = 'hidden';
					// backdrop 是獨立的 body 子元素，要跳過 inert 才能「點背景關閉」
					trapModal(sheet, { keep: [backdrop] });
				};
				const closeSheet = () => {
					if (!sheet?.classList.contains('open')) return;
					sheet.classList.remove('open');
					backdrop?.classList.remove('open');
					document.body.style.overflow = '';
					releaseModal(); // 焦點還給 FAB
				};

				fab?.addEventListener('click', openSheet);
				closeBtn?.addEventListener('click', closeSheet);
				backdrop?.addEventListener('click', closeSheet);

				// 點 TOC 連結後自動關閉 sheet
				sheet?.querySelectorAll('.toc-sheet-link').forEach(link => {
					link.addEventListener('click', closeSheet);
				});
			}

			/* ── Code Block Copy ── */
			function setupCopyButtons() {
				document.querySelectorAll<HTMLPreElement>('.prose pre').forEach(pre => {
					// 已包過的略過（保險，理論上換頁是全新 DOM）
					if (pre.parentElement?.classList.contains('code-wrapper')) return;

					const wrapper = document.createElement('div');
					wrapper.className = 'code-wrapper';
					pre.parentNode!.insertBefore(wrapper, pre);
					wrapper.appendChild(pre);

					const btn = document.createElement('button');
					btn.className = 'copy-btn';
					btn.setAttribute('aria-label', t('post.copyCode'));
					btn.innerHTML = `<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>`;
					wrapper.appendChild(btn);

					btn.addEventListener('click', async () => {
						const code = pre.querySelector('code')?.textContent ?? '';
						try {
							await navigator.clipboard.writeText(code);
							btn.classList.add('copied');
							btn.innerHTML = `<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>`;
							setTimeout(() => {
								btn.classList.remove('copied');
								btn.innerHTML = `<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>`;
							}, 1500);
						} catch {
							// clipboard 不可用時靜默失敗
						}
					});
				});
			}

			/* ── Image Lightbox ── */
			function setupLightbox() {
				const lightbox = document.getElementById('img-lightbox');
				const lightboxImg = document.getElementById('lightbox-img') as HTMLImageElement | null;
				if (!lightbox || !lightboxImg) return;

				const openLightbox = (src: string, alt: string) => {
					lightboxImg.src = src;
					lightboxImg.alt = alt;
					lightbox.classList.add('open');
					document.body.style.overflow = 'hidden';
					trapModal(lightbox);
				};
				const closeLightbox = () => {
					if (!lightbox.classList.contains('open')) return;
					lightbox.classList.remove('open');
					document.body.style.overflow = '';
					releaseModal();
				};

				document.querySelectorAll<HTMLImageElement>('.prose img').forEach(img => {
					img.addEventListener('click', () => openLightbox(img.src, img.alt));
				});

				lightbox.addEventListener('click', e => {
					if (e.target === lightbox) closeLightbox();
				});
			}

			// 每次換頁（含首次載入）重新初始化各功能
			document.addEventListener('astro:page-load', () => {
				setupTocObserver();
				setupMobileToc();
				setupCopyButtons();
				setupLightbox();
			});

			// Escape 關閉 sheet / lightbox：只掛一次（document 跨換頁存活），即時查 DOM。
			// 先確認真的有開著的才動手，避免空按 Escape 誤觸 releaseModal 的焦點還原。
			document.addEventListener('keydown', e => {
				if (e.key !== 'Escape') return;
				const sheet = document.getElementById('toc-sheet');
				const lightbox = document.getElementById('img-lightbox');
				if (!sheet?.classList.contains('open') && !lightbox?.classList.contains('open')) return;
				sheet?.classList.remove('open');
				document.getElementById('toc-backdrop')?.classList.remove('open');
				lightbox?.classList.remove('open');
				document.body.style.overflow = '';
				releaseModal();
			});
</script>
