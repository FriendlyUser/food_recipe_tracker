---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import FormattedDate from './FormattedDate.astro';
import { postDescription } from '../lib/posts';
import defaultHero from '../assets/hero-image-holder.jpg';

interface Props {
	posts: CollectionEntry<'blog'>[];
	// 標題語意層級：列表頁卡片直接在 h1 下用 h2（預設）；
	// 在主頁則嵌在 h2 區塊標題下，要傳 3 以維持 h1→h2→h3 不跳級。
	headingLevel?: 2 | 3;
	// 緊湊版（主頁用）：卡片固定高 160px，描述桌機 hover 才浮現（手機恆顯）。
	compact?: boolean;
}

const { posts, headingLevel = 2, compact = false } = Astro.props;
---

<ul class:list={['post-list', { compact }]}>
	{posts.map((post) => (
		<li class="post-item">
			<a href={`/blog/${post.id}/`} class="post-card">
				<div class="card-image">
					<Image
						width={320}
						height={200}
						src={post.data.heroImage ?? defaultHero}
						alt=""
					/>
				</div>
				<div class="card-body">
					<div class="card-top">
						<span class="card-date">
							<FormattedDate date={post.data.pubDate} />
						</span>
						{post.data.tags.length > 0 && (
							<div class="card-tags">
								{post.data.tags.slice(0, 3).map(tag => (
									<span class="card-tag">{tag}</span>
								))}
							</div>
						)}
					</div>
					{headingLevel === 3
						? <h3 class="card-title">{post.data.title}</h3>
						: <h2 class="card-title">{post.data.title}</h2>}
					<p class="card-desc">{postDescription(post)}</p>
				</div>
			</a>
		</li>
	))}
</ul>

<style>
	.post-list {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: 1rem;
	}

	.post-card {
		display: flex;
		flex-direction: row;
		text-decoration: none;
		color: inherit;
		border-radius: 12px;
		overflow: hidden;
		background: rgba(var(--gray-light), 0.35);
		border: 1px solid rgba(var(--gray-light), 0.6);
		transition: transform 0.25s ease, box-shadow 0.25s ease;
	}

	.post-card:hover {
		transform: translateY(-3px);
		box-shadow: var(--box-shadow);
	}

	/* ── 封面圖 ── */
	.card-image {
		flex: 0 0 260px;
		overflow: hidden;
	}

	.card-image img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
		transition: transform 0.35s ease;
	}

	.post-card:hover .card-image img {
		transform: scale(1.06);
	}

	/* ── 右側內容 ── */
	.card-body {
		flex: 1;
		padding: 0.85rem 1.1rem;
		display: flex;
		flex-direction: column;
		overflow: hidden;
	}

	.card-top {
		display: flex;
		align-items: center;
		gap: 0.6rem;
		flex-wrap: wrap;
		margin-bottom: 0.4rem;
	}

	.card-date {
		font-size: 0.78rem;
		color: rgb(var(--gray));
	}

	.card-tags {
		display: flex;
		gap: 0.3rem;
		flex-wrap: wrap;
	}

	.card-tag {
		font-size: 0.7rem;
		padding: 0.15em 0.55em;
		border-radius: 999px;
		background: rgba(var(--gray-light), 0.7);
		color: rgb(var(--gray-dark));
		border: 1px solid rgba(var(--gray), 0.25);
	}

	.card-title {
		margin: 0 0 0.4rem 0;
		font-size: 1rem;
		line-height: 1.35;
		color: rgb(var(--black));
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
		transition: color 0.2s ease;
	}

	.post-card:hover .card-title {
		color: var(--accent-dark);
	}

	.card-desc {
		margin: 0;
		font-size: 0.8rem;
		color: rgb(var(--gray));
		line-height: 1.5;
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}

	/* ── 緊湊版（主頁）── */
	.post-list.compact .post-card {
		height: 160px;
	}

	.compact .card-desc {
		opacity: 0;
		transform: translateY(6px);
		transition: opacity 0.3s ease, transform 0.3s ease;
	}

	.compact .post-card:hover .card-desc {
		opacity: 1;
		transform: translateY(0);
	}

	/* ── 手機版 ── */
	@media (max-width: 720px) {
		.post-list.compact .post-card {
			height: auto;
		}

		.compact .card-desc {
			opacity: 1;
			transform: none;
			transition: none;
		}

		.card-image {
			flex: 0 0 120px;
		}

		.card-title {
			font-size: 0.9rem;
		}

		.card-date {
			font-size: 0.72rem;
		}
	}
</style>
