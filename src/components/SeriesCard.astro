---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  href: string;
  title: string;
  meta: string[];
  description?: string;
  heroImage?: string;
  heroDarkness?: number;
  // 標題語意層級：在 /series 等頁面卡片直接在 h1 下用 h2（預設）；
  // 在主頁則嵌在 h2 區塊標題下，要傳 3 以維持 h1→h2→h3 不跳級。
  headingLevel?: 2 | 3;
}

// 卡片背景圖走 Astro 圖片優化：圖放在 src/assets/series/，heroImage 傳入的是
// 該資料夾下的 glob key（見 src/data/series.ts）。eager glob 在建置期把每個檔案
// 解析成 ImageMetadata，再交給 <Image> 縮放/重壓成 webp（原圖 1600px 會被縮到
// 顯示尺寸，省下大量位元組）。public/ 的 background-image 做不到這件事。
const seriesImages = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/series/*.{webp,jpg,jpeg,png,avif}',
  { eager: true },
);

const { href, title, meta, description, heroImage, heroDarkness = 0.5, headingLevel = 2 } = Astro.props;
const heroMeta = heroImage ? seriesImages[heroImage]?.default : undefined;
---

<a class="series-card" href={href}>
  {heroMeta
    ? <Image class="bg" src={heroMeta} alt="" width={800} loading="lazy" />
    : <div class="bg" style="background: linear-gradient(135deg, #2E86A8, #1F7191)"></div>
  }
  {heroMeta && (
    <div
      class="overlay"
      style={`background: linear-gradient(to top, rgba(0,0,0,${heroDarkness}) 0%, rgba(0,0,0,${heroDarkness}) 45%, transparent 90%)`}
    ></div>
  )}
  <div class="content">
    {headingLevel === 3
      ? <h3 class="card-title">{title}</h3>
      : <h2 class="card-title">{title}</h2>}
    {description && <p class="desc">{description}</p>}
    <div class="meta">
      {meta.map(m => <span>{m}</span>)}
    </div>
  </div>
</a>

<style>
  .series-card {
    position: relative;
    display: block;
    height: 200px;
    border-radius: 12px;
    overflow: hidden;
    text-decoration: none;
  }
  .bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    transition: transform 0.35s ease;
  }
  .series-card:hover .bg {
    transform: scale(1.05);
  }
  .overlay {
    position: absolute;
    inset: 0;
  }
  .content {
    position: relative;
    z-index: 1;
    /* 全站沒有 border-box reset，預設 content-box 下 height:100% 會是 200px 內容、
       再外加 1rem 上下 padding（共 232px），溢出 200px 卡片 32px；flex-end 把
       子元素貼到 232px 底部，被卡片 overflow:hidden 裁掉最底的 meta。改 border-box
       讓 padding 內縮，內容區回到 168px，meta 正常落在卡片底部上方。 */
    box-sizing: border-box;
    height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: 1rem 1.25rem;
  }
  .content .card-title {
    margin: 0 0 0.3rem 0;
    font-size: 1.2rem;
    color: white;
    text-shadow: 0 1px 6px rgba(0, 0, 0, 0.6);
    line-height: 1.3;
  }
  .desc {
    font-size: 0.82rem;
    color: rgba(255, 255, 255, 0.85);
    margin: 0 0 0.3rem 0;
    line-height: 1.4;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .meta {
    font-size: 0.8rem;
    color: rgba(255, 255, 255, 0.75);
    display: flex;
    gap: 0.75rem;
  }
</style>
